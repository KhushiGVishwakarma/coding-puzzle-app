<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pagebkg"
    tools:context=".ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center" >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:layout_marginTop="@dimen/_100sdp"
            app:cardCornerRadius="30dp"
            app:cardElevation="20dp" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="30dp" >

                <TextView
                    style="@style/viewParent.headerText"
                    android:layout_marginBottom="20dp"
                    android:text="User Profile : "
                    android:textColor="@color/my_primary"
                    android:layout_gravity="center"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/profileCircleImageView"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            app:civ_border_width="2dp"
                            app:civ_border_color="@color/black"
                            android:src="@drawable/person1"
                            android:layout_marginTop="15dp"
                            android:layout_marginRight="10dp"/>

                        <TextView
                            android:id="@+id/usernameTextView"
                            style="@style/viewParent.headerText"
                            android:text="Shivani V"
                            android:textSize="18dp"
                            android:layout_toRightOf="@id/profileCircleImageView"
                            android:layout_marginTop="20dp"/>

                        <TextView
                            style="@style/viewParent.headerText"
                            android:text="Edit personal details"
                            android:textSize="16sp"
                            android:textColor="#5D5C5C"
                            android:layout_below="@id/usernameTextView"
                            android:layout_toRightOf="@id/profileCircleImageView"/>

                        <ImageView
                            style="@style/viewParent"
                            android:src="@drawable/ic_more"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>

                    </RelativeLayout>

                <TextView
                    style="@style/viewParent.headerText.settingsMiniTitle"
                    android:text="Profile"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/usernameIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:civ_border_width="2dp"
                        app:civ_border_color="@color/black"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/ic_edit_username"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/editUsernameTextView"
                        style="@style/viewParent.headerText.settingsTextIcon"
                        android:layout_marginLeft="3dp"
                        android:layout_toRightOf="@id/usernameIcon"
                        android:text=" Edit Username"
                        android:layout_centerVertical="true"/>

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/emailIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:civ_border_width="2dp"
                        app:civ_border_color="@color/black"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/ic_edit_email"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/editEmailTextView"
                        style="@style/viewParent.headerText.settingsTextIcon"
                        android:layout_marginLeft="3dp"
                        android:layout_toRightOf="@id/emailIcon"
                        android:text=" Edit Email"
                        android:layout_centerVertical="true"/>

                </RelativeLayout>

                <TextView
                    android:id="@+id/changePasswordTextView"
                    style="@style/viewParent.headerText.settingsTextIcon"
                    android:drawableLeft="@drawable/ic_edit_password"
                    android:text="Change Password" />

                <TextView
                    android:id="@+id/logout"
                    style="@style/viewParent.headerText.settingsTextIcon"
                    android:drawableLeft="@drawable/ic_logout"
                    android:text="Logout" />

                <TextView
                    style="@style/viewParent.headerText.settingsMiniTitle"
                    android:text="About app"/>

                <TextView
                    android:id="@+id/About"
                    style="@style/viewParent.headerText.settingsTextIcon"
                    android:drawableLeft="@drawable/ic_about"
                    android:text="About" />

                <TextView
                    style="@style/viewParent.headerText.settingsMiniTitle"
                    android:text="Feedback Form"/>

                <TextView
                    android:id="@+id/Feedback"
                    style="@style/viewParent.headerText.settingsTextIcon"
                    android:drawableLeft="@drawable/baseline_feedback_24"
                    android:text="Feedback" />

                <TextView
                    style="@style/viewParent.headerText.settingsMiniTitle"
                    android:text="App ver 2.0.1"
                    android:textAlignment="center"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bottom_background"
        android:elevation="2dp"
        app:itemIconSize="30dp"
        app:itemIconTint="@drawable/item_selector"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/bottom_menu" />

</RelativeLayout>