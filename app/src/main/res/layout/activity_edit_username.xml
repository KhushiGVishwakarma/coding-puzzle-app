<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/pagebkg"
    tools:context=".EditUsernameActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Username : "
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="@color/my_primary"
                android:layout_gravity="center"
                android:padding="10dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/usernameIcon"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    app:civ_border_width="2dp"
                    app:civ_border_color="@color/black"
                    android:layout_alignParentStart="true"
                    android:src="@drawable/ic_edit_username"
                    android:layout_marginEnd="10dp"/>

                <EditText
                    android:id="@+id/newUsernameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/usernameIcon"
                    android:layout_marginLeft="3dp"
                    android:layout_centerVertical="true"
                    android:hint="Enter new username"
                    android:padding="10dp"
                    android:textSize="20dp"
                    android:layout_marginTop="20dp"/>

            </RelativeLayout>

            <Button
                android:id="@+id/saveUsernameButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save Username"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:padding="10dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>